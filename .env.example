# Copy this file to .env and fill in real values. .env is gitignored — never commit real credentials.

# "sandbox" or "production". Controls which eBay OAuth/API base URLs are used.
EBAY_ENV=sandbox

# From developer.ebay.com -> Application Keys
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Your registered "RuName" (eBay redirect URL name) for the 3-legged auth flow.
# This is NOT a literal URL — it's a name eBay maps internally to your real
# callback URL, configured under Application Keys -> User Tokens -> "Get a Token from eBay via Your Application".
EBAY_RU_NAME=

# Space-separated OAuth scopes. Start minimal and add what you need.
# Full list: https://developer.ebay.com/api-docs/static/oauth-scopes.html
EBAY_SCOPES=https://api.ebay.com/oauth/api_scope

# Additional scopes typically needed for 3-legged (user-level) Sell APIs:
EBAY_USER_SCOPES=https://api.ebay.com/oauth/api_scope https://api.ebay.com/oauth/api_scope/sell.inventory https://api.ebay.com/oauth/api_scope/sell.account https://api.ebay.com/oauth/api_scope/sell.fulfillment https://api.ebay.com/oauth/api_scope/sell.marketing

# Local server port and public base URL (used to build the callback route info in logs)
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# Where to persist tokens on disk (JSON file). Keep this out of git (see .gitignore).
TOKEN_STORE_PATH=.data/tokens.json
